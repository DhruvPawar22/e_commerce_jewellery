DATABASE_URL=postgresql+asyncpg://ecommerce:ecommerce@db:5432/ecommerce

JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_MINUTES=60

ADMIN_USERNAME=admin
# bcrypt hash of the admin password -- generate with:
# poetry run python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# comma-separated, no spaces -- every origin allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# local dev is plain HTTP -- MUST be true in any real (HTTPS) deployment
COOKIE_SECURE=false

# from your Cloudinary dashboard's "Product Environment Credentials" section
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
